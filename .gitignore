# =============================================================================
# NEXA .gitignore
# -----------------------------------------------------------------------------
# NOTE: The NEXA technology stack has not been finalized yet. This file covers
# the most likely stacks (Node.js / TypeScript, Python) plus common OS/editor
# artifacts and secrets. Trim and refine once the stack is locked in.
# =============================================================================

# ---- Secrets / environment (NEVER commit) -----------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.token
secrets/
**/secrets/
credentials.json
**/credentials.json

# ---- Node.js / TypeScript ----------------------------------------------------
node_modules/
dist/
build/
.next/
.nuxt/
.cache/
.turbo/
.parcel-cache/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.eslintcache
*.tsbuildinfo

# ---- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
htmlcov/
.coverage
.coverage.*

# ---- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---- Editors / IDEs ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Misc --------------------------------------------------------------------
*.local
