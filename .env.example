# =============================================================================
# NEXA environment variables.
# Copy this file to `.env.local` and fill in your values.
# NEVER commit real secrets. `.env.local` is git-ignored.
# =============================================================================

# ---- Supabase (required for Phase 1: database + auth) -----------------------
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret (NEVER exposed to the browser). Used for privileged/admin
# operations such as the /api/health database probe and push dispatch.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Featherless AI (Phase 2 — AI planning) --------------------------------
# Server-side ONLY. Never expose to the browser. Get a key from Featherless.
FEATHERLESS_API_KEY=
# OpenAI-compatible base URL (per specs/architecture.md §7). Rarely changed.
# FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
# Primary model id (Qwen3-class default; confirm exact id in the Featherless catalog).
NEXA_FEATHERLESS_MODEL=Qwen/Qwen3-32B

# ---- Web Push (Phase D) -----------------------------------------------------
# Public key is baked into the client (public by design). Private key + subject
# are SERVER-ONLY and must never be committed or shipped to the browser.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Optional. When set, /api/notifications/dispatch requires x-dispatch-token.
DISPATCH_TOKEN=
