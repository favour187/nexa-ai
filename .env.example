# =============================================================================
# NEXA environment variables.
# Copy this file to `.env.local` and fill in your values.
# NEVER commit real secrets. `.env.local` is git-ignored.
# =============================================================================

# ---- Supabase (required for Phase 1: database + auth) -----------------------
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret (NEVER exposed to the browser). Used for privileged/admin
# operations such as the /api/health database probe.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Featherless AI (Phase 2 — AI layer) ------------------------------------
# NOT used in Phase 1. Server-side only. Leave commented until the AI phase.
# FEATHERLESS_API_KEY=
# NEXA_FEATHERLESS_MODEL=Qwen/Qwen3-32B
